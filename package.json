{
  "name": "just-plan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev -w @just-plan/web",
    "dev:api": "npm run dev -w @just-plan/api",
    "dev:ml": "npm run dev -w @just-plan/ml",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run prisma:generate -w @just-plan/api",
    "db:push": "npm run prisma:push -w @just-plan/api"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
